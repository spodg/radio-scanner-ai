[Unit]
Description=Pi Local Transcriber (Whisper)
After=pi-scanner.service
Wants=pi-scanner.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/scanner
ExecStart=/home/pi/scanner/venv/bin/python3 /home/pi/scanner/pi_transcriber.py
Restart=always
RestartSec=15

# --- CPU containment ---
# Pin Whisper to CPU cores 2-3 only. Cores 0-1 stay free for the capture
# process, sshd, and the dashboard so the Pi NEVER becomes unresponsive.
AllowedCPUs=1-3
# Allow 3 cores (= up to 70% of the 4-core Pi) so local transcription runs at
# full pace on tiny.en with n_threads=3. Core 0 stays reserved for the scanner;
# the scanner also keeps core 1 but at CPUWeight=200 vs this service's 10, so
# capture always wins when they share core 1. CPUQuota caps total transcriber
# load at 280% so ~30% of the Pi stays free and the dashboard stays responsive.
CPUQuota=280%
# Lowest scheduling priority and weight — always yields to everything else.
Nice=19
CPUWeight=10
IOWeight=10

# --- Memory containment ---
MemoryHigh=250M
MemoryMax=320M
MemorySwapMax=50M
OOMScoreAdjust=800

[Install]
WantedBy=multi-user.target
