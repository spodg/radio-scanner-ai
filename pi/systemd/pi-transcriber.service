[Unit]
Description=Pi Local Transcriber (Whisper)
After=pi-scanner.service
Wants=pi-scanner.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/scanner
ExecStart=/home/pi/scanner/venv/bin/python3 /home/pi/scanner/pi_transcriber.py
Restart=always
RestartSec=15

# --- CPU containment ---
# Pin Whisper to CPU cores 2-3 only. Cores 0-1 stay free for the capture
# process, sshd, and the dashboard so the Pi NEVER becomes unresponsive.
AllowedCPUs=2-3
# Allow both allocated cores (= 50% of the 4-core Pi) so local transcription
# runs at full pace on tiny.en with n_threads=2. The cpuset above keeps it off
# cores 0-1, so even at this cap the capture/dashboard stay responsive and total
# Pi CPU stays well under ~80%.
CPUQuota=200%
# Lowest scheduling priority and weight — always yields to everything else.
Nice=19
CPUWeight=10
IOWeight=10

# --- Memory containment ---
MemoryHigh=250M
MemoryMax=320M
MemorySwapMax=50M
OOMScoreAdjust=800

[Install]
WantedBy=multi-user.target
